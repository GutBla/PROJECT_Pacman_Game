<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Pacman_Game.Views.HighScoresWindow"
        Title="Puntuaciones"
        Width="600"
        Height="600">
	<Panel Background="#0c0c44">
		<StackPanel Margin="20" Spacing="15">
			<Image Source="/Assets/titles/High_Scores_titles.png"
                   Width="400"
                   HorizontalAlignment="Center"/>

			<Border Background="#1a1a5a" CornerRadius="10" Padding="10" Margin="0,20,0,0">
				<DataGrid x:Name="ScoresDataGrid"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="Transparent"
                          BorderThickness="0"
                          RowHeight="40"
                          CanUserResizeColumns="False"
                          CanUserSortColumns="False"
                          IsReadOnly="True">
					<DataGrid.Columns>
						<DataGridTextColumn Header="Posición" Binding="{Binding Rank}" Width="120"/>
						<DataGridTextColumn Header="Jugador" Binding="{Binding Name}" Width="200"/>
						<DataGridTextColumn Header="Puntuación" Binding="{Binding Score}" Width="120"/>
					</DataGrid.Columns>
				</DataGrid>
			</Border>

			<Button Content="Volver al Menú"
                    Click="BackButton_Click"
                    Width="180" Height="40"
                    Background="#FFCC00" Foreground="Black"
                    FontSize="16" FontWeight="Bold"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    HorizontalAlignment="Center"
                    Cursor="Hand"/>
		</StackPanel>
	</Panel>
</Window>
