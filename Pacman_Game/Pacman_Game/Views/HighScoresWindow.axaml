<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Pacman_Game.Views.HighScoresWindow"
        Title="Puntuaciones"
        Width="600"
        Height="600">
	<Panel Background="#0c0c44">
		<StackPanel Margin="20" Spacing="15">
			<Image Source="/Assets/titles/High_Scores_titles.png" Width="400" HorizontalAlignment="Center"/>

			<ItemsControl x:Name="ScoresList" Background="Transparent">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border Background="#1a1a66" CornerRadius="5" Margin="0,5" Padding="10">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<TextBlock Text="{Binding Name}" Foreground="White" FontSize="16"/>
								<TextBlock Text="{Binding Score}" Foreground="White" FontSize="16"
                                           Grid.Column="1"/>
							</Grid>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<Button Content="Volver al Menú" Click="BackButton_Click"
					Width="180" Height="40"
					Background="#FFCC00" Foreground="Black"
					FontSize="16" FontWeight="Bold"
					HorizontalContentAlignment="Center"
					VerticalContentAlignment="Center"
					HorizontalAlignment="Center"
					Cursor="Hand"/>
		</StackPanel>
	</Panel>
</Window>