<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Pacman_Game.Views.HighScoresWindow"
        Title="Puntuaciones"
        Width="600"
        Height="600">
	<ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
		<Panel Background="#0c0c44">
			<StackPanel Margin="20" Spacing="15">

				<Image Source="/Assets/titles/High_Scores_titles.png"
                       Width="400"
                       HorizontalAlignment="Center"/>

				<Border Background="#1a1a5a" CornerRadius="10" Padding="10" Margin="0,20,0,0">
					<StackPanel>
						<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
							<TextBlock Text="Posición" Width="100" Foreground="#FFCC00" FontWeight="Bold"/>
							<TextBlock Text="Jugador" Width="300" Foreground="#FFCC00" FontWeight="Bold"/>
							<TextBlock Text="Puntuación" Width="100" Foreground="#FFCC00" FontWeight="Bold"/>
						</StackPanel>

						<ListBox ItemsSource="{Binding Scores}" Background="Transparent" BorderThickness="0">
							<ListBox.ItemTemplate>
								<DataTemplate>
									<StackPanel Orientation="Horizontal">
										<TextBlock Text="{Binding Rank}" Width="100" Foreground="White"/>
										<TextBlock Text="{Binding Name}" Width="300" Foreground="White"/>
										<TextBlock Text="{Binding Score}" Width="100" Foreground="White"/>
									</StackPanel>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</StackPanel>
				</Border>

				<Button Content="Volver al Menú"
                        Click="BackButton_Click"
                        Width="180" Height="40"
                        Background="#FFCC00" Foreground="Black"
                        FontSize="16" FontWeight="Bold"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        HorizontalAlignment="Center"
                        Cursor="Hand"/>
			</StackPanel>
		</Panel>
	</ScrollViewer>
</Window>