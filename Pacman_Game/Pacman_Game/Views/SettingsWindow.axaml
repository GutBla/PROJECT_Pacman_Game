<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Pacman_Game.Views.SettingsWindow"
        Title="Configuración"
        Width="600"
        Height="600"
		Icon="avares://Pacman_Game/Assets/custom/Pac-Man_icon.ico">
	<Panel Background="#0c0c44">
		<ScrollViewer VerticalScrollBarVisibility="Auto" Margin="20">
			<StackPanel Spacing="15">
				<Image Source="avares://Pacman_Game/Assets/titles/Configuración_titles.png"
                       Width="450" HorizontalAlignment="Center"/>

				<Border CornerRadius="10" Background="#003092" Padding="15" Margin="0,5">
					<StackPanel Spacing="10">
						<TextBlock Text="Jugabilidad" Foreground="White" FontSize="18" FontWeight="Bold"/>

						<TextBlock Text="Dificultad:" Foreground="White" FontSize="16"/>
						<ComboBox SelectedItem="{Binding Difficulty}" Margin="0,5">
							<ComboBoxItem Content="Fácil"/>
							<ComboBoxItem Content="Normal"/>
							<ComboBoxItem Content="Difícil"/>
							<ComboBoxItem Content="Personalizado"/>
						</ComboBox>

						<StackPanel Spacing="10" Margin="0,10,0,0">
							<TextBlock Text="Número de Vidas Iniciales:" Foreground="White"/>
							<StackPanel Orientation="Horizontal" Spacing="10">
								<Button Content="-" Width="30" Click="DecreaseLivesClick"/>
								<TextBlock Text="{Binding LivesCount}" Width="30" TextAlignment="Center"
                                          VerticalAlignment="Center" FontSize="16" Foreground="White"/>
								<Button Content="+" Width="30" Click="IncreaseLivesClick"/>
							</StackPanel>
						</StackPanel>

						<StackPanel Spacing="10" Margin="0,10,0,0">
							<TextBlock Text="Velocidad del Juego:" Foreground="White"/>
							<Slider Minimum="50" Maximum="200" Value="{Binding GameSpeed}"
                                   TickFrequency="10" IsSnapToTickEnabled="True"/>
							<TextBlock Text="{Binding GameSpeed, StringFormat='Velocidad: {0}'}"
                                      HorizontalAlignment="Center" Foreground="White"/>
						</StackPanel>
					</StackPanel>
				</Border>

				<Border CornerRadius="10" Background="#003092" Padding="15" Margin="0,5">
					<StackPanel Spacing="10">
						<TextBlock Text="Sonido" Foreground="White" FontSize="18" FontWeight="Bold"/>

						<TextBlock Text="Volumen general:" Foreground="White" FontSize="16"/>
						<Slider Minimum="0" Maximum="100" Value="{Binding Volume}" Margin="0,5"/>

						<CheckBox Content="Mute / Silencio" IsChecked="{Binding IsMuted}"
                                 Foreground="White" FontSize="16" Margin="0,10,0,0"/>
					</StackPanel>
				</Border>

				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20" Margin="0,30,0,0">
					<Button Content="Aplicar" Click="ApplyButton_Click"
                            Width="180" Height="40"
                            Background="#FFCC00" Foreground="Black"
                            FontSize="16" FontWeight="Bold"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Cursor="Hand"/>
					<Button Content="Volver al Menú" Click="BackButton_Click"
                            Width="180" Height="40"
                            Background="#FFCC00" Foreground="Black"
                            FontSize="16" FontWeight="Bold"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Cursor="Hand"/>
				</StackPanel>
			</StackPanel>
		</ScrollViewer>
	</Panel>
</Window>