<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pacman_Game.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Pacman_Game.Views.MainWindow"
        Title="Pacman"
        Width="600"
        Height="600"
        Icon="avares://Pacman_Game/Assets/custom/Pac-Man_icon.ico"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Manual">

	<Design.DataContext>
		<vm:MainViewModel/>
	</Design.DataContext>

	<Window.Background>
		<ImageBrush Stretch="UniformToFill" Source="avares://Pacman_Game/Assets/background/background_menu.png"/>
	</Window.Background>

	<Grid>
		<Border Margin="40" Background="#20000000" CornerRadius="15">
			<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
				<Image Source="avares://Pacman_Game/Assets/titles/Pac-Man_title.png"
                       Width="350" Height="150"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>

				<Button Command="{Binding StartGameCommand}"
                        Content="Iniciar Juego"
                        Width="200" Height="50"
                        Background="#FFCC00" Foreground="Black"
                        FontSize="16" FontWeight="Bold"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        HorizontalAlignment="Center"
                        Cursor="Hand"/>

				<Button Command="{Binding HowToPlayCommand}"
                        Content="Cómo Jugar"
                        Width="200" Height="50"
                        Background="#FFCC00" Foreground="Black"
                        FontSize="16" FontWeight="Bold"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        HorizontalAlignment="Center"
                        Cursor="Hand"/>

				<Button Command="{Binding HighScoresCommand}"
                        Content="High Scores"
                        Width="200" Height="50"
                        Background="#FFCC00" Foreground="Black"
                        FontSize="16" FontWeight="Bold"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        HorizontalAlignment="Center"
                        Cursor="Hand"/>

				<Button Command="{Binding SettingsCommand}"
                        Content="Configuración"
                        Width="200" Height="50"
                        Background="#FFCC00" Foreground="Black"
                        FontSize="16" FontWeight="Bold"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        HorizontalAlignment="Center"
                        Cursor="Hand"/>
			</StackPanel>
		</Border>
	</Grid>
</Window> 